# AI Crypto Scalping Trading Bot - Example Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_STRONG=gpt-4o

# Binance API Credentials
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret
BINANCE_TESTNET=false

# Trading and Currency Parameters
PKR_USDT_RATE=278.50
USER_AMOUNT_PKR=5000.0
MIN_DESIRED_PROFIT_PKR=50.0

# Trading Modes
PAPER_TRADING=true
AUTO_TRADING=false
AUTO_CLOSE=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./trading_bot.db
